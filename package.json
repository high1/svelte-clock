{
  "description": "svelte clock, inspired by sauron clock",
  "devDependencies": {
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@html-eslint/eslint-plugin": "0.68.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-svelte": "3.24.1",
    "eslint-plugin-yml": "3.10.0",
    "globals": "17.14.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-checker": "0.14.5",
    "vitest": "5.1.0",
    "vitest-browser-svelte": "3.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "12.18.0"
    },
    "runtime": {
      "name": "node",
      "onFail": "download",
      "version": "26.13.0"
    }
  },
  "imports": {
    "#*": [
      "./*",
      "./*.ts"
    ]
  },
  "keywords": [
    "svelte",
    "clock",
    "svg"
  ],
  "license": "MIT",
  "name": "svelte-clock",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/high1/svelte-clock.git"
  },
  "scripts": {
    "build": "vite build",
    "check": "$npm_execpath run svelte:check && $npm_execpath run tsc:check",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "playwright": "playwright install --only-shell chromium",
    "preview": "vite preview",
    "start": "vite",
    "svelte:check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "tsc:check": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}
